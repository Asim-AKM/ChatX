@using Microsoft.AspNetCore.Components.Routing

<aside class="chatx-sidebar @(isExpanded ? "expanded" : "collapsed")">

    <!-- Header -->
    <div class="sidebar-header">

        <a href="/" class="brand" aria-label="ChatX Home">
            <span class="brand-logo">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linejoin="round">
                    <path d="M12 3 20 7.5v9L12 21l-8-4.5v-9L12 3z" />
                    <path d="m4 7.5 8 4.5 8-4.5M12 12v9" />
                </svg>
            </span>

            @if (isExpanded)
            {
                <span class="brand-name">ChatX</span>
            }
        </a>

        <button class="collapse-button"
                @onclick="ToggleSidebar"
                aria-label="@(isExpanded ? "Collapse sidebar" : "Expand sidebar")"
                title="@(isExpanded ? "Collapse sidebar" : "Expand sidebar")">

            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round"
                 stroke-linejoin="round">
                @if (isExpanded)
                {
                    <path d="m14 18-6-6 6-6" />
                }
                else
                {
                    <path d="m10 18 6-6-6-6" />
                }
            </svg>
        </button>

    </div>

    <!-- Navigation -->
    <nav class="sidebar-navigation" aria-label="Main navigation">

        <!-- Search -->
        @if (isExpanded)
        {
            <div class="sidebar-search">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round">
                    <circle cx="11" cy="11" r="7" />
                    <path d="m20 20-4-4" />
                </svg>
                <input type="search" placeholder="Search chats..." />
            </div>
        }
        else
        {
            <button class="icon-button"
                    title="Search chats"
                    aria-label="Search chats"
                    @onclick="ExpandSidebar">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round">
                    <circle cx="11" cy="11" r="7" />
                    <path d="m20 20-4-4" />
                </svg>
            </button>
        }

        @if (isExpanded)
        {
            <span class="section-label">WORKSPACE</span>
        }

        <NavLink href="chats" class="nav-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.8" stroke-linecap="round"
                 stroke-linejoin="round">
                <path d="M12 5v14M5 12h14" />
            </svg>
            @if (isExpanded)
            {
                <span>New Chat</span>
            }
        </NavLink>

        <NavLink href="" Match="NavLinkMatch.All" class="nav-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.8" stroke-linecap="round"
                 stroke-linejoin="round">
                <rect x="4" y="4" width="16" height="16" rx="3" />
                <path d="M4 10h16M10 4v16" />
            </svg>
            @if (isExpanded)
            {
                <span>Dashboard</span>
            }
        </NavLink>

        <NavLink href="chats" class="nav-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.8" stroke-linecap="round"
                 stroke-linejoin="round">
                <path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8A8.5 8.5 0 0 1 12.5 3h.5a8.5 8.5 0 0 1 8 8z" />
            </svg>
            @if (isExpanded)
            {
                <span>Chats</span>
                <span class="unread-count">3</span>
            }
        </NavLink>

        <NavLink href="contacts" class="nav-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.8" stroke-linecap="round"
                 stroke-linejoin="round">
                <circle cx="9" cy="8" r="4" />
                <path d="M2 21v-2a7 7 0 0 1 14 0v2M19 8v6M22 11h-6" />
            </svg>
            @if (isExpanded)
            {
                <span>Contacts</span>
            }
        </NavLink>

        <NavLink href="calls" class="nav-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.8" stroke-linecap="round"
                 stroke-linejoin="round">
                <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7l.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5l2.8.7a2 2 0 0 1 1.7 2.1z" />
            </svg>
            @if (isExpanded)
            {
                <span>Calls</span>
            }
        </NavLink>

        @if (isExpanded)
        {
            <span class="section-label recent-label">RECENT CHATS</span>

            <div class="recent-chat">
                <div class="contact-avatar avatar-green">A</div>
                <div class="contact-details">
                    <span>Alex Morgan</span>
                    <small>Hey, how are you?</small>
                </div>
                <span class="online-dot"></span>
            </div>

            <div class="recent-chat">
                <div class="contact-avatar avatar-purple">S</div>
                <div class="contact-details">
                    <span>Sarah Wilson</span>
                    <small>See you tomorrow!</small>
                </div>
            </div>
        }

    </nav>

    <!-- Bottom account area -->
    <div class="sidebar-bottom">

        <NavLink href="settings" class="nav-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.8" stroke-linecap="round"
                 stroke-linejoin="round">
                <circle cx="12" cy="12" r="3" />
                <path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1-2.8 2.8-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5v.2h-4v-.2a1.7 1.7 0 0 0-1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1-2.8-2.8.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3v-4h.2a1.7 1.7 0 0 0 1.5-1 1.7 1.7 0 0 0-.3-1.8l-.1-.1 2.8-2.8.1.1a1.7 1.7 0 0 0 1.8.3 1.7 1.7 0 0 0 1-1.5V3h4v.2a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1 2.8 2.8-.1.1a1.7 1.7 0 0 0-.3 1.8 1.7 1.7 0 0 0 1.5 1h.2v4h-.2a1.7 1.7 0 0 0-1.4 1z" />
            </svg>
            @if (isExpanded)
            {
                <span>Settings</span>
            }
        </NavLink>

        <NavLink href="profile" class="nav-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.8" stroke-linecap="round"
                 stroke-linejoin="round">
                <circle cx="12" cy="8" r="4" />
                <path d="M4 21v-2a8 8 0 0 1 16 0v2" />
            </svg>
            @if (isExpanded)
            {
                <span>My Profile</span>
            }
        </NavLink>

        <button type="button" class="nav-item logout-button"
                title="Logout">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.8" stroke-linecap="round"
                 stroke-linejoin="round">
                <path d="M10 17l5-5-5-5M15 12H3" />
                <path d="M12 3h7a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-7" />
            </svg>
            @if (isExpanded)
            {
                <span>Logout</span>
            }
        </button>

        <div class="user-profile">
            <div class="user-avatar">U</div>

            @if (isExpanded)
            {
                <div class="user-info">
                    <strong>ChatX User</strong>
                    <small>Personal account</small>
                </div>

                <span class="profile-menu">•••</span>
            }
        </div>

    </div>

</aside>

@code {
    private bool isExpanded = true;

    private void ToggleSidebar()
    {
        isExpanded = !isExpanded;
    }

    private void ExpandSidebar()
    {
        isExpanded = true;
    }
}